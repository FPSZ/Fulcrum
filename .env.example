# 枢衡运行时配置示例。复制为 .env 后按需修改(.env 不入库)。
# 所有变量带 FULCRUM_ 前缀。

# 服务
# 本机直跑(python -m fulcrum)用 127.0.0.1;Docker 容器内须 0.0.0.0 才对外可达
# (deploy/docker-compose.yml 已显式设 0.0.0.0,用 compose 时本项无需改)。
FULCRUM_HOST=127.0.0.1
FULCRUM_PORT=8000
FULCRUM_LOG_LEVEL=INFO

# 前端静态目录(生产指向已构建的 console/dist;留空则只提供 API、不托管控制台)。
# Docker 镜像内固定为 /app/console/dist(compose 已设),本机开发可留空走 Vite dev。
FULCRUM_FRONTEND_DIR=

# 模型:OpenAI 兼容端点(本地 Ollama/vLLM,或 MiMo 等云端)。demo 用 model: openai 适配器读取这三项。
FULCRUM_MODEL_ENDPOINT=http://127.0.0.1:11434/v1
FULCRUM_MODEL_API_KEY=
FULCRUM_MODEL_NAME=mimo-v2.5-pro

# 网关上游(被保护的企业智能体)接入:首启默认地址;运行期真正生效的接入配置
# 存于下方 gateway 配置文件(控制台「上游接入」可改、热加载)。
FULCRUM_UPSTREAM_AGENT_ENDPOINT=http://127.0.0.1:8800
FULCRUM_GATEWAY_CONFIG_PATH=data/runtime/gateway.json

# 能力装配清单路径(留空使用包内默认 src/fulcrum/config/fulcrum.yml)
FULCRUM_CAPABILITY_CONFIG=

# 审计/运行目录
FULCRUM_AUDIT_DB_PATH=data/runtime/fulcrum.sqlite

# 登录鉴权(账号口令 + 服务端会话)
FULCRUM_AUTH_DB_PATH=data/runtime/auth.sqlite
FULCRUM_SESSION_TTL_HOURS=12
FULCRUM_SESSION_COOKIE_NAME=fulcrum_session
# 经 TLS 反代对外时务必置 true(Cookie 仅在 HTTPS 下回传);本机 http 调试保持 false
FULCRUM_SESSION_COOKIE_SECURE=false
FULCRUM_SESSION_COOKIE_SAMESITE=strict
# 暴力破解防护:连续失败达上限即锁定账号一段时间
FULCRUM_LOGIN_MAX_FAILURES=5
FULCRUM_LOGIN_LOCKOUT_MINUTES=15
# 首次启动引导管理员(库内无用户时生效)。口令留空 → 随机生成并在日志打印一次,请立即修改。
FULCRUM_BOOTSTRAP_ADMIN_USERNAME=admin
FULCRUM_BOOTSTRAP_ADMIN_PASSWORD=
